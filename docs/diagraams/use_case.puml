@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Кладовщик" as Clerk
actor "Администратор" as Admin

package "ИС Учета Склада Продуктов" {
    usecase "Авторизация в системе" as UC1
    usecase "Оформить приемку товара (приход)" as UC2
    usecase "Оформить списание/отгрузку (расход)" as UC3
    usecase "Провести инвентаризацию" as UC4
    usecase "Просмотреть уведомления о сроках годности" as UC5
    usecase "Управление номенклатурой и поставщиками" as UC6
    usecase "Управление учетными записями" as UC7
    usecase "Сформировать отчет по остаткам" as UC8
}

' Связи для Кладовщика
Clerk --> UC1
Clerk --> UC2
Clerk --> UC3
Clerk --> UC4
Clerk --> UC5

' Связи для Администратора
Admin --> UC1
Admin --> UC6
Admin --> UC7
Admin --> UC8
Admin --> UC5

@enduml